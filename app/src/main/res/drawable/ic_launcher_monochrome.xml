<!-- Themed (monochrome) icon: the bubble as an outline with the bridge inside.
     Launchers tint only the alpha channel, so every shape is opaque and nothing overlaps
     (a filled bubble would hide the bridge). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- bubble outline with a tail at the lower left -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M38,30h32a12,12 0,0 1,12 12v18a12,12 0,0 1,-12 12h-22l-12,9v-9.5a12,12 0,0 1,-10 -11.5v-18a12,12 0,0 1,12 -12z" />
    <!-- bridge deck -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M37,58h34" />
    <!-- arch -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40,58q14,-18 28,0" />
    <!-- piers -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M47,50.5v7.5M54,48v10M61,50.5v7.5" />
</vector>
